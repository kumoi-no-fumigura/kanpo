   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "きのふとはさすかさ苗のたとられていなはにまよふ秋の初風",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "秋くれはさらてもものゝかなしきに夕の山にせみのなくなる",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "鵲のはしはかりをやわたすらん秋まつかはのもみちあへすは",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "渡るせを何たとるらんかさゝきの橋は雲井にありとこそきけ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "天河くもゐなからもたなはたやあふをいつこと尋れわふらん",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "なそもかく人くるしめにまたる覽やすの渡りのやすく渡らて",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "七夕のあさせたとらんかたしらすこそのわたりのあまの川霧",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いまこそはやそ瀬の霧のたえまよりほのかにみゆれ天の河舟",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "玉床にひとよもちりをはらはすはあまの河原や山とならまし",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "たゝ一夜思へはつらし遠娯と手まくらかへてぬろはぬるかは",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あきたつ日老にのそみてもなをいける〓とをおもひ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "秋も猶まれなる中とたなはたのよにしらするや忍ふなるらん",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "七夕もたのめはこそはなからへて神代のうらみ猶のこるらめ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "あけぬとも梶棹かくせわたし守またふたゝひと年にやはまつ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かきにほすはなたの帶とみゆるまて露にむすへる朝顏のはな",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "しつこゝろあらしとこそは思ひやれあまつ星合のあけ方の空",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "うきをしる淚とやみむ袖かきのうへにかゝれるあさかほの露",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "たのめたる人やはあるにあちきなく聞すくされぬ〓の音かな",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "夕されはいさ何事としらねとも風にかたらふにはのをきはら",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "今更になにかうからむ〓としわれきゝはしめたるをきの音かは",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "柴の戶のあくるもしらすきりこめてわかよとみゆる朝顏の花",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "物思ふなみたやたねとなりにけむさも袖ぬらすをきのをと哉",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "うきなからよすかとたのむ宿なれといへてしぬへき荻の音哉",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "たのまれぬうきよのなかをいまみれは猶さきあへす朝顔の花",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "音するはをとせぬよりも淋しきにあはれなかけそ〓のうは風",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "はなにさくのをなつかしみ分ゆけはうつりかこくも秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "夜もふけぬをきのはよあはれしれしはしまとろむ老の枕に",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "花にさく草のみたれに露をきてしつかにもふる秋のあめかな",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "はなすゝきなとかほにいてゝ秋風の心もしらす人まねくらむ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "しけきのゝ露におれふすはな薄かたみに袖をしほるとそみる",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "さならても老ぬるみにはいねかてを萩の下葉にかこちつる哉",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "いかはかりなにおふ草のしほろらむを花かもとにあまる白露",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "秋萩の花のまきれに露わけてつまやとまろとしかそなくなる",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "たか秋のつらさなれはかをみなへし思ひの色に花のさくらむ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いつ方へつまりかれすと秋萩のうつろふのへに鹿のなくらむ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "山吹のもとのまかきのをみなへし春より秋のいろそかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "誰かきく飛火かくれにつまこめて草ふみちらすさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夕されはくすはふ小野の秋風にたのめはつまと鹿やなくらん",
   "kana": "",
   "speaker": "",
   "page": 201,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "うらやまし野原にわふる虫たにもたのむ草葉のかけはあり覺",
   "kana": "",
   "speaker": "閑放集卷第三",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "ふかきよのね覺からかとおもへともあはれなりつる鹿の聲哉",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "うきはみな我身ひとつと思ふよに又いかなれは虫のわふらむ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "鹿のたつさやまかすその秋風にくさはをしなみ露そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "ほたるとふゆふかけくさの白露にけたをる虫もあきとなくん",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "野へみれはうらみてもなを葛のはにやますそ秋の風は吹ける",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "くれゆけはたれまつ虫の聲ならし人をもしちぬ宿のまかきに",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "すみわひて野となるやとの夕くれはあらしよりけに秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "あはれともうしともものを思ふより外には秋の夕くれもなし",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "いかなれは日とにかはる心にもおなしつらさのあきの夕くれ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "野へみれはくさのは〓ににをく玉をなにそは露とあき「そふく",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "今さらになとかなみたと思へともいとなかるゝはあきの夕暮",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "いまさらにはらはゝ袖やそほちなむしけき蓬のあきのしら露",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "猶もうき山のおくこそかなしけれいつちゆかまし秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "かきりあれはよもの草はにをく露も老のねさめの涙はかりは",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "あきのひのさすや夕への山かけはした行みつも音そさむけき",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "なにゆへのなみたなるらしたつた姫の山をしなみをける白露",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "たひ人やとをちの里にすきぬらん秋風きむみ日そくれにける",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "色〓〓の花みてくらす秋のゝはよるもとまれと虫そなくなる",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "かりかねはたか玉章としらねともかけてまたるゝタくれの空",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "色かはるあさちか露のやとりまて風にみたれてむしそ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "あさち原しめゆふものゝ秋風にこりすやたれをまつ虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "うき雲のゆきかふそらの秋風にかたへみたれて鴈そなくなる",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "たまきはる夕さりくれは老らくの命もしらす月そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "ふけゆけげ笛の音あまたきこゆえいかなる江にか月のすむ覽",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "久堅は月とうものななれはやひとつにすめることひ成らむ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "かもめとふ入江をさむみさよふけて友なきあまや月をみる覽",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "ひるとのみみゆるにしるしいつ方によはなりぬらむ秋の月影",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "船とむるいり江の楓しもさえてよふかきかねを月にきくかな",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "みなそこに深くうつれる月影やふちにしつめし玉とみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "わひぬれは夢みるほとのなくさめを圍もる月にかなはさり鳬",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "あつさ弓はるかにとをく月さえていそへの小松あき風そふく",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "我やとを月にたつぬる人もあらはあれたるほとか哀とやみむ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "なかめはやいかなるそのゝ秋風にみちては月のくまなかる覽",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "思ふこそあはれえけれあつまやのまやの隙もる月をなかめて",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "そしはれていつれのせきかてらすらむ心にかゝる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "村雨のなこりのとこに影とめてあかしのこやに月そやとれる",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "空はれてよわたる風やをくろらむ月にひとしきはつかりの聲",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "みれはまつむかしの人のこゝろまて思ひしらるゝ秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "ふる雨のいとはれぬ哉もろともに月をみるへき我身ならねは",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "中〓〓にくもらぬ夜半の月にこそ空なる星はまれに見えけれ",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "君はなを雲まの月もなかめけむうきみはかりそ時雨はてにし",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "すゑとをくなかるゝ水にやとりても猶あまりある月の影かな",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "見てすきぬ年のいそちにあまるまて世間もしらす秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 202,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "あらはさぬかけとはなとかおもひけむ心にすめる秋のよの月",
   "kana": "",
   "speaker": "三百カ十ハ",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "かつみれは老の淚やへたつらむうとくもあるかなあきの月影",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "いかはかりゆかしからまし秋の月うきよのほかの光なりせは",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "世をはさて何ゆへすてし我なれはうきにとまりて月をみる覽",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "ころもうつ聲するかたにやとかりてわか心から夢もむすはす",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "あちきなし空すみわたる月みれはものうらやみの限なりけり",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "まつ人のこぬかつらさやかさぬらむ宿をかへてもうつ衣かな",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "みな人のすてゝともとはならぬよにあばれなりける月の影哉",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "なに人か衣うつらむあれけてゝ風もたまらぬやとゝみゆるに",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "衣うつをとこそをちにきこゆなれ山のこのはに風やふくらむ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "しら菊をうへしやいつこ霜をへてむらさきおふる籬とそみる",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "つれもなくおほくの人をさきたてゝひとり今宵も月をみる哉",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "露よりもおいの泪そつもるらむあれたる庭のきくのふちとは",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "かくはかりうきにたえたる程ならは月にわするゝ涙ともかな",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "なかむれはなとてそほつる我袖そ月やは人のなみたならぬに",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "初膓のこゑさこゆなり朝またきうへてもいにし秋田かるらし",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "なかむるにこけの袂のしをるゝは月やうきみのなみた成らむ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "夕くれはいなはもそよとふく風に人こそとはねをやまたの庵",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "ねさめしてひとりそみつる手枕のしつくにやとるよはの月影",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "むかしにはあはれ心のかはるかな老ていまみるあきのよの月",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "かへるさのみちもしられす山里にあはれをそふる霧の夕へは",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "やとるへきくもるかとてやはらふらむ老のなみたの袖の秋風",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "露はなをおくと見えけり夕きりのなにともなくてぬらす袖哉",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "しはしこそ霧もへたつれはゝそ原終に色にそあきかせはふく",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "秋霧のたつのとはやくなりしよりはれす物思ふやとの淋しさ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "散かゝる木のはの露の山おろしにひとやりならすぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "朝々のいはねのみちも見えぬまて秋きりふかしまきたてる山",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "たかために錦をしくとみゆるまて紅葉をとこにあき風のふく",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "いとゝわか袖はほされし長月のしくれのときにはや成にけり",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "露霜のあきの別のころなれはなみたならてもそてはぬれけり",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "よろつよに十度すむへき河水のいろにいてたる秋のもみちは",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "袖ぬらす時雨を空にとゝめをきてかたみにせよと秋や行らむ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "やまひめのうはきなるらし紫のこきいろましる峰のもみちは",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "くれぬれはまたもや秋と思ふにそおいそしられぬ心なりけれ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "こさまさる山にこのけの夕時雨誰にみすへきいろにそむらむ",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "おしと思ふよのまもいたく悲しきにねてあかさはや秋の別を",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "夕霧やふかくたつらしくる人もなくてやみぬるみねの紅葉は",
   "kana": "",
   "speaker": "",
   "page": 203,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
